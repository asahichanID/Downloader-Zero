{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/progress/(.*)",
      "destination": "/api/progress?jobId=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  }
}
